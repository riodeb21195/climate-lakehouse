# Nach .env kopieren und anpassen. .env nie committen.

# Anzahl der DWD-Stationen (0 = alle)
STATION_LIMIT=50
# Frühestes Jahr in Silver und Gold
START_YEAR=1950

# Alarme: "log" schreibt nur ins Log, "slack" postet zusätzlich an den Webhook
ALERT_CHANNEL=log
SLACK_WEBHOOK_URL=

# Infrastruktur (nur lokal; für alles Geteilte ändern)
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=change-me
LAKEKEEPER_ENCRYPTION_KEY=change-me-to-a-long-random-string
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=lakehouse
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=change-me-s3-secret
CATALOG_URI=http://localhost:8181/catalog
WAREHOUSE=climate
AIRFLOW_JWT_SECRET=change-me-to-another-long-random-string
SUPERSET_SECRET_KEY=change-me-to-a-third-long-random-string
SUPERSET_ADMIN_PASSWORD=change-me-superset

# Optionale Download-Einstellungen (Standardwerte)
# HTTP_TIMEOUT_S=30
# HTTP_MAX_RETRIES=5
# HTTP_REQUESTS_PER_S=5
# DOWNLOAD_WORKERS=4

# Optionale Transform-Einstellungen (Standardwerte)
# BRONZE_BATCH_FILES=20
# MAX_REJECT_RATIO=0.01
