# Copy to .env and adjust. Never commit .env.

# Number of DWD stations to process (0 = all stations)
STATION_LIMIT=50
# Earliest year that ends up in silver/gold
START_YEAR=1950

# Alerting: "log" writes alerts to the log only, "slack" also posts to the webhook
ALERT_CHANNEL=log
SLACK_WEBHOOK_URL=
