# Copy to .env and adjust. Never commit .env.

# Number of DWD stations to process (0 = all stations)
STATION_LIMIT=50
# Earliest year that ends up in silver/gold
START_YEAR=1950

# Alerting: "log" writes alerts to the log only, "slack" also posts to the webhook
ALERT_CHANNEL=log
SLACK_WEBHOOK_URL=

# Infrastructure (local only; change for anything shared)
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=change-me
LAKEKEEPER_ENCRYPTION_KEY=change-me-to-a-long-random-string
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=lakehouse
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=change-me-s3-secret
CATALOG_URI=http://localhost:8181/catalog
WAREHOUSE=climate

# Optional download tuning (defaults shown)
# HTTP_TIMEOUT_S=30
# HTTP_MAX_RETRIES=5
# HTTP_REQUESTS_PER_S=5
# DOWNLOAD_WORKERS=4
